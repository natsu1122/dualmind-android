<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No INTERNET, storage, microphone or telemetry permissions. SAF grants selected-file access. -->
    <application
        android:name=".DualMindApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_dualmind"
        android:roundIcon="@drawable/ic_dualmind"
        android:theme="@style/Theme.DualMind"
        android:usesCleartextTraffic="false">
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <activity android:name=".MainActivity" android:exported="true"
            android:theme="@style/Theme.DualMind.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
